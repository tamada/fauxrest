#compdef fauxrest

autoload -U is-at-least

_fauxrest() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-L+[Specify the log level]:LEVEL:(error warn info debug trace)' \
'--level=[Specify the log level]:LEVEL:(error warn info debug trace)' \
'-c+[Path to the configuration file]:CONFIG_FILE:_files' \
'--config=[Path to the configuration file]:CONFIG_FILE:_files' \
'-l+[Layout to use for the output]:LAYOUT:((index\:"Outputs endpoints as \`/endpoint/index.\[ext\]\`. Highly compatible with all static web servers, maintaining clean URLs"
file\:"Outputs endpoints as extensionless files (\`/endpoint\`). **Smart Fallback Specification**\: To avoid physical file-directory collisions, collections that contain sub-paths are automatically replaced (fallback) by \`.../index.\[ext\]\` files during compilation"
extension\:"Outputs endpoints with explicit extensions (\`/endpoint.\[ext\]\`). 100% web server compatible"))' \
'--layout=[Layout to use for the output]:LAYOUT:((index\:"Outputs endpoints as \`/endpoint/index.\[ext\]\`. Highly compatible with all static web servers, maintaining clean URLs"
file\:"Outputs endpoints as extensionless files (\`/endpoint\`). **Smart Fallback Specification**\: To avoid physical file-directory collisions, collections that contain sub-paths are automatically replaced (fallback) by \`.../index.\[ext\]\` files during compilation"
extension\:"Outputs endpoints with explicit extensions (\`/endpoint.\[ext\]\`). 100% web server compatible"))' \
'-d+[Path to the output directory \[default\: dist\]]:DEST_DIR:_files' \
'--dest=[Path to the output directory \[default\: dist\]]:DEST_DIR:_files' \
'-s+[Serializer to use for the output. \[available\: json, typescript, sql\] \[default\: json\]]:SERIALIZER:_default' \
'--serializer=[Serializer to use for the output. \[available\: json, typescript, sql\] \[default\: json\]]:SERIALIZER:_default' \
'--minify[If true, minify the output]' \
'(--minify)--no-minify[If set, disable minification (overrides config)]' \
'--overwrite[If true, overwrite existing files in the destination directory]' \
'--copy-static[Copy all non-JSON static files from the data directory into each destination (allow all). \$static exclude globs still take precedence.]' \
'--gencomp[Generate completion files]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'-V[Print version]' \
'--version[Print version]' \
'::inputs -- Path to the input data directory:_default' \
&& ret=0
}

(( $+functions[_fauxrest_commands] )) ||
_fauxrest_commands() {
    local commands; commands=()
    _describe -t commands 'fauxrest commands' commands "$@"
}

if [ "$funcstack[1]" = "_fauxrest" ]; then
    _fauxrest "$@"
else
    compdef _fauxrest fauxrest
fi
